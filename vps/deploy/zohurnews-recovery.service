[Unit]
Description=Checkpointed publisher archive recovery for ZohurNews outage
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/zohurnews/releases/research-v3/research/backfill.py
TimeoutStartSec=2h
Nice=15
CPUQuota=50%
MemoryMax=512M
UMask=0022
NoNewPrivileges=true

